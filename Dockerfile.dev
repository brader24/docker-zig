# Latest Zig development (master) toolchain image for building applications
# in other repos. Fetches master from https://ziglang.org/download/index.json
# at image build time.
#
# Build and tag (from this directory):
#   docker build -f Dockerfile.dev -t zig:dev .
#   docker build -f Dockerfile.dev --no-cache --build-arg CACHE_BUST=$(date -u +%Y-%m-%d) -t zig:dev .
#
# Use from an application repo (mount the app at /src):
#   docker run --rm -it -v ${PWD}:/src zig:dev
#   docker run --rm -v ${PWD}:/src zig:dev zig build -Doptimize=ReleaseSafe
#
# See README.md for registry publish and VS Code Dev Container templates.

FROM debian:stable-slim

LABEL org.opencontainers.image.title="zig-dev"
LABEL org.opencontainers.image.description="Latest Zig development build toolchain for building Zig applications"
LABEL org.opencontainers.image.source="https://ziglang.org/download/"

ARG TARGETARCH
# Change this to invalidate the download layer and fetch a newer master build.
ARG CACHE_BUST=0

ENV ZIG_GLOBAL_CACHE_DIR=/var/cache/zig \
    ZIG_LOCAL_CACHE_DIR=/tmp/zig-local-cache \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    SHELL=/bin/bash \
    PATH="/usr/local/zig:${PATH}"

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        bash \
        ca-certificates \
        curl \
        git \
        jq \
        sudo \
        xz-utils \
    && rm -rf /var/lib/apt/lists/*

RUN set -eu; \
    echo "CACHE_BUST=${CACHE_BUST}"; \
    arch="${TARGETARCH:-}"; \
    if [ -z "${arch}" ]; then \
        case "$(uname -m)" in \
            x86_64) arch=amd64 ;; \
            aarch64|arm64) arch=arm64 ;; \
            *) echo "unsupported architecture: $(uname -m)" >&2; exit 1 ;; \
        esac; \
    fi; \
    case "${arch}" in \
        amd64) zig_arch=x86_64 ;; \
        arm64) zig_arch=aarch64 ;; \
        *) echo "unsupported architecture: ${arch}" >&2; exit 1 ;; \
    esac; \
    index="$(curl -fsSL --retry 5 --retry-delay 2 https://ziglang.org/download/index.json)"; \
    key="${zig_arch}-linux"; \
    tarball_url="$(printf '%s' "${index}" | jq -er --arg key "${key}" '.master[$key].tarball')"; \
    zig_sha256="$(printf '%s' "${index}" | jq -er --arg key "${key}" '.master[$key].shasum')"; \
    zig_version="$(printf '%s' "${index}" | jq -er '.master.version')"; \
    echo "installing Zig ${zig_version} for ${key}"; \
    curl -fsSL --retry 5 --retry-delay 2 -o /tmp/zig.tar.xz "${tarball_url}"; \
    echo "${zig_sha256}  /tmp/zig.tar.xz" | sha256sum -c -; \
    mkdir -p /usr/local/zig; \
    tar -xJf /tmp/zig.tar.xz --strip-components=1 -C /usr/local/zig; \
    rm /tmp/zig.tar.xz; \
    zig version; \
    printf '%s\n' "${zig_version}" > /usr/local/zig/DEV_VERSION

ARG USERNAME=dev
ARG USER_UID=1000
ARG USER_GID=1000

COPY docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh

RUN chmod +x /usr/local/bin/docker-entrypoint.sh \
    && groupadd --gid "${USER_GID}" "${USERNAME}" \
    && useradd --uid "${USER_UID}" --gid "${USER_GID}" -m -s /bin/bash "${USERNAME}" \
    && echo "${USERNAME} ALL=(ALL) NOPASSWD:ALL" > "/etc/sudoers.d/${USERNAME}" \
    && chmod 0440 "/etc/sudoers.d/${USERNAME}" \
    && mkdir -p /src "${ZIG_GLOBAL_CACHE_DIR}" "${ZIG_LOCAL_CACHE_DIR}" \
    && chown -R "${USERNAME}:${USERNAME}" /src "${ZIG_GLOBAL_CACHE_DIR}" "${ZIG_LOCAL_CACHE_DIR}" "/home/${USERNAME}" /usr/local/zig/DEV_VERSION

WORKDIR /src

USER ${USERNAME}

ENTRYPOINT ["/usr/local/bin/docker-entrypoint.sh"]
CMD []
